    sfxVolume: 0
  - speaker: "\uCE20\uD0A4\uB098\uAC00"
    line: "\uC815\uB9D0? \uB098\uB3C4 \uC624\uB298 \uC2DC\uBD80\uC57C\uC5D0 \uAC00\uC57C\uD558\uB294\uB370.
