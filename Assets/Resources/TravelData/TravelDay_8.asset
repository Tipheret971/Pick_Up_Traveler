  - speaker: "\uB098\uAC15\uB9BC"
    line: "\uC624\uB298\uC740 \uC2DC\uBD80\uC57C\uC5D0 \uAC00\uBCFC \uC0DD\uAC01\uC774\uC5D0\uC694"
